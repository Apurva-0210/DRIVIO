# ==============================================================================
# DRIVIO Transit OS - Environment Configuration Reference
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=your_super_secure_random_jwt_secret_here_32_chars_min
COOKIE_SECRET=your_cookie_encryption_secret_here

# Database Configuration (PostgreSQL)
# Either provide a full connection string:
# DATABASE_URL=postgres://user:password@hostname:5432/fleetease?sslmode=require
# Or configure discrete parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=fleetease
DB_SSL=false

# Cross-Origin Resource Sharing (comma-separated origins or *)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Client Build-Time Flags (fleetease-web)
# For unified production deployment, leave empty to automatically resolve to current origin
REACT_APP_API_URL=
REACT_APP_SOCKET_URL=

# Optional Third-Party Gateways
REACT_APP_RAZORPAY_KEY_ID=rzp_test_samplekey
RAZORPAY_KEY_SECRET=sample_razorpay_secret
REACT_APP_GOOGLE_MAPS_API_KEY=
